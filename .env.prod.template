# Copy to .env.prod on the VM. Never commit the real file.

# GitHub Container Registry owner (GitHub username or organization)
GHCR_OWNER=your-github-user

# Image names become ghcr.io/<owner>/<prefix>-{api,worker,web,migrate}
IMAGE_PREFIX=monno

# Used only by direct compose commands. deploy-images-vm.sh overrides it with
# the required tag argument, so deployments use an immutable version.
IMAGE_TAG=replace-with-git-sha

# PostgreSQL container
DB_USER=postgres
DB_PASSWORD=replace-with-a-long-random-password
DB_NAME=appdb

# Bound to 127.0.0.1 only; host nginx proxies to these ports.
API_PORT=3001
WEB_PORT=3000

# Public site origin for robots.txt / sitemap.xml (no trailing slash)
SITE_URL=https://example.com

# Optional overrides (paths relative to docker-compose.prod.yml)
API_ENV_FILE=./env/api.env
WORKER_ENV_FILE=./env/worker.env
