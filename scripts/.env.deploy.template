# Used by: pnpm run deploy:env  /  pnpm run deploy:vm
# Copy to scripts/.env.deploy (git-ignored) and fill it in.

# --- SSH target ---
# Option A: SSH config Host alias (recommended if you already `ssh deploytest`)
#   Leave DEPLOY_USER unset/commented — scp/ssh use the alias's User.
# DEPLOY_HOST=deploytest

# Option B: explicit user@host (devuser workflow, or fresh ubuntu user)
DEPLOY_USER=ubuntu
DEPLOY_HOST=123.456.0.789

DEPLOY_PATH=/opt/apps/monno

# deploy:env modes:
#   pnpm run deploy:env              # docker (default) → .env.prod + env/*.env
#   pnpm run deploy:env -- bare      # PM2 layout → apps/*/.env
