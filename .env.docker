# Docker Compose environment variables
# Copy this to .env.docker.local to override defaults (git-ignored)
# Or set env vars before running: export DB_USER=custom_user && docker-compose up

# Project name (prefixes all containers, networks, and volumes)
COMPOSE_PROJECT_NAME=monno

# Database
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=appdb
DB_PORT=5432

# Redis
REDIS_PORT=6379

# Full stack (docker-compose.stack.yml) — host port mappings
# Use different ports if local `pnpm dev` is already on 3000/3001
API_PORT=3001
WEB_PORT=3000

# Baked into the web image at build time (browser → api)
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME=Monno
