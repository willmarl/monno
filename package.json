{
  "name": "monno",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel --stream run dev",
    "build": "pnpm -r run build",
    "start": "pnpm -r --parallel --stream run start",
    "db:up": "docker compose --env-file .env.docker up -d",
    "db:down": "docker compose --env-file .env.docker down",
    "db:test:up": "docker compose --env-file .env.docker.test up -d",
    "db:test:down": "docker compose --env-file .env.docker.test down",
    "db:migrate": "bash ./scripts/migrate.sh",
    "db:sync-schema": "bash ./scripts/sync-prisma-schema.sh",
    "db:sync-schema:check": "bash ./scripts/sync-prisma-schema.sh --check",
    "deploy:env": "bash ./scripts/deploy-env.sh",
    "deploy:vm": "bash ./scripts/deploy-vm.sh",
    "crud": "node guide/cli-crud-builder.js",
    "validate-resource": "node guide/validate-resource.js",
    "ai-api-test": "node guide/ai-api-test.js"
  },
  "devDependencies": {
    "@inquirer/prompts": "^8.4.0",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "inquirer": "^13.4.0"
  }
}
