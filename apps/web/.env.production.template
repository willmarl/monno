################################################################################
#                            🌐 WEB (Next.js)                                 #
################################################################################

# Frontend URLs
NEXT_PUBLIC_API_URL="http://api.example.com"
# Canonical site origin for robots.txt / sitemap.xml (no trailing slash)
NEXT_PUBLIC_SITE_URL="https://example.com"
# Or set SITE_URL at runtime in Docker (preferred for container deploys)

# security.txt (RFC 9116)
SECURITY_CONTACT_EMAIL=security@example.com
# SECURITY_POLICY_URL=https://example.com/security-policy

NEXT_PUBLIC_APP_NAME=Monno

# Stripe
NEXT_PUBLIC_STRIPE_ENABLED=true

# PostHog Analytics
NEXT_PUBLIC_POSTHOG_KEY=phc_xxx
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry
NEXT_PUBLIC_SENTRY_DSN=https://xxx.ingest.us.sentry.io/123
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production # development | staging | production