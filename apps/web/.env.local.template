################################################################################
#                            🌐 WEB (Next.js)                                 #
################################################################################

# Frontend URLs
NEXT_PUBLIC_API_URL="http://localhost:3001"
# Canonical site origin for robots.txt / sitemap.xml (no trailing slash)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# security.txt (RFC 9116) — set a real mailbox before production
SECURITY_CONTACT_EMAIL=security@example.com
# Or full URI: SECURITY_CONTACT=mailto:security@example.com
# Optional: SECURITY_TXT_EXPIRES=2027-07-23T00:00:00.000Z
# Optional: SECURITY_POLICY_URL=https://example.com/security-policy

NEXT_PUBLIC_APP_NAME=Monno

# Stripe
NEXT_PUBLIC_STRIPE_ENABLED=true

# PostHog Analytics
NEXT_PUBLIC_POSTHOG_KEY=phc_xxx
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry
NEXT_PUBLIC_SENTRY_DSN=https://xxx.ingest.us.sentry.io/123
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development # development | staging | production